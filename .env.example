# ==============================================================================
# Steely Platform - Environment Variables Template
# ==============================================================================

# Database Configuration (PostgreSQL 15+ / Supabase Core - EDTS-378)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:54322/postgres
DATABASE_URL_CORE=postgresql+asyncpg://postgres:postgres@localhost:54322/postgres
POSTGRES_USER=steely_admin
POSTGRES_PASSWORD=steely_secure_password_2026
POSTGRES_DB=steely_db

# Security & Authentication (ADR-09)
JWT_SECRET_KEY=steely_super_jwt_secret_key_production_2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Vision Scanner Microservice (ADR-01, ADR-12)
VISION_SCANNER_URL=http://localhost:8000
MODEL_DEVICE=cpu

# Frontend Configuration
VITE_API_URL=http://localhost:8080/api/v1
VITE_SCANNER_URL=http://localhost:8000
