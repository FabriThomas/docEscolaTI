# Copie para .env (que não vai para o Git). Os valores abaixo são de exemplo, nunca reais.

ENVIRONMENT=local

# Supabase Auth: use o JWKS (chaves assimétricas) OU o segredo HS256 do projeto.
SUPABASE_JWKS_URL=
SUPABASE_JWT_SECRET=troque-por-um-segredo-de-teste
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWT_ISSUER=

# Cloudflare Turnstile (ADR-21). A 3ª falha de login exige o captcha.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
TURNSTILE_FAILURE_THRESHOLD=3

# Idempotency-Key (ADR-14): retenção de 72 h.
IDEMPOTENCY_TTL_HOURS=72

# Origens liberadas no CORS (domínio do Cloudflare Pages), separadas por vírgula.
CORS_ORIGINS=http://localhost:5173
