# Copie para .env.local e ajuste. Nunca coloque segredos reais aqui: tudo que começa com VITE_ vai para o navegador.

# Endereço do FastAPI (sem /api/v1), para produção ou servidor remoto.
VITE_API_URL=

# Em desenvolvimento, manda /api para o FastAPI local pelo proxy do Vite (evita CORS).
# "npm run dev:hibrido" já usa http://127.0.0.1:8000.
VITE_API_PROXY=

# API simulada no navegador: "tudo" (padrão sem servidor), "parcial" (só o que o FastAPI ainda não tem) ou "nao".
VITE_API_MOCK=

# Só no modo parcial: segredo de TESTE igual ao SUPABASE_JWT_SECRET do backend/.env local,
# para o login simulado gerar um JWT que o FastAPI aceita em GET /api/v1/me.
VITE_DEV_JWT_SECRET=

# Chave pública (site key) do Cloudflare Turnstile. Vazio em desenvolvimento = chave de teste da Cloudflare.
VITE_TURNSTILE_SITE_KEY=
