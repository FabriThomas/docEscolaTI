{
  "$description": "Tokens do Design System Steely (W3C DTCG). Fonte: manual da marca e telas aprovadas (docs/05-design). Níveis: primitivo → semântico → componente (ADR-19).",
  "primitive": {
    "color": {
      "$type": "color",
      "navy": {
        "950": { "$value": "#070F18", "$description": "Fundo da página" },
        "900": { "$value": "#0D1B2A", "$description": "Charcoal — fundo do app" },
        "800": { "$value": "#11233A", "$description": "Superfície (cartões)" },
        "700": { "$value": "#1A3250", "$description": "Borda, divisória, trilho" }
      },
      "green": {
        "500": { "$value": "#1DDB6A", "$description": "Verde Steely" },
        "200": { "$value": "#A8EFC4", "$description": "Verde ESG" }
      },
      "gray": {
        "500": { "$value": "#6B7A8D", "$description": "Cinza — ícones inativos e bordas de controles" }
      },
      "white": { "$value": "#FFFFFF" },
      "red": {
        "400": { "$value": "#FF5A5F", "$description": "Alerta — só erro, campo obrigatório e segurança" }
      }
    },
    "space": {
      "$type": "dimension",
      "0": { "$value": "0px" },
      "1": { "$value": "4px" },
      "2": { "$value": "8px" },
      "3": { "$value": "12px" },
      "4": { "$value": "16px" },
      "5": { "$value": "20px" },
      "6": { "$value": "24px" },
      "8": { "$value": "32px" },
      "10": { "$value": "40px" },
      "12": { "$value": "48px" },
      "16": { "$value": "64px" }
    },
    "radius": {
      "$type": "dimension",
      "sm": { "$value": "8px", "$description": "Botão pequeno, ícone" },
      "md": { "$value": "12px", "$description": "Campo, cartão, botão" },
      "lg": { "$value": "18px", "$description": "Destaque" },
      "full": { "$value": "999px" }
    },
    "font": {
      "family": {
        "$type": "fontFamily",
        "title": { "$value": "'Space Grotesk', system-ui, sans-serif" },
        "body": { "$value": "'DM Sans', system-ui, sans-serif" }
      },
      "size": {
        "$type": "dimension",
        "11": { "$value": "11px" },
        "13": { "$value": "13px" },
        "14": { "$value": "14px" },
        "15": { "$value": "15px" },
        "16": { "$value": "16px" },
        "18": { "$value": "18px" },
        "20": { "$value": "20px" },
        "24": { "$value": "24px" }
      },
      "weight": {
        "$type": "fontWeight",
        "regular": { "$value": 400 },
        "medium": { "$value": 500 },
        "semibold": { "$value": 600 },
        "bold": { "$value": 700 }
      }
    }
  },
  "semantic": {
    "color": {
      "$type": "color",
      "bg": {
        "page": { "$value": "{primitive.color.navy.950}" },
        "app": { "$value": "{primitive.color.navy.900}" },
        "surface": { "$value": "{primitive.color.navy.800}" },
        "raised": { "$value": "{primitive.color.navy.700}" },
        "field": { "$value": "#FFFFFF08", "$description": "Branco 3% — fundo de campo, chip e botão secundário" },
        "field-disabled": { "$value": "#6B7A8D14", "$description": "Cinza 8% — campo somente leitura" },
        "brand": { "$value": "{primitive.color.green.500}" },
        "brand-subtle": { "$value": "#1DDB6A0D", "$description": "Verde 5% — caixa informativa" },
        "brand-soft": { "$value": "#1DDB6A1F", "$description": "Verde 12% — fundo de ícone e etiqueta" },
        "esg-subtle": { "$value": "#A8EFC414", "$description": "Verde ESG 8%" },
        "esg-soft": { "$value": "#A8EFC424", "$description": "Verde ESG 14% — selo ESG" },
        "danger-soft": { "$value": "#FF5A5F1F", "$description": "Alerta 12%" },
        "muted-soft": { "$value": "#6B7A8D29", "$description": "Cinza 16% — fundo de ícone neutro" },
        "overlay": { "$value": "#070F18CC", "$description": "Fundo de modal" }
      },
      "text": {
        "primary": { "$value": "{primitive.color.white}" },
        "muted": { "$value": "#FFFFFF99", "$description": "Branco 60%. Substitui o #6B7A8D em texto, que tem só 3,6:1 sobre a superfície (WCAG AA exige 4,5:1)" },
        "placeholder": { "$value": "#FFFFFF8C", "$description": "Branco 55%" },
        "brand": { "$value": "{primitive.color.green.500}" },
        "esg": { "$value": "{primitive.color.green.200}" },
        "danger": { "$value": "{primitive.color.red.400}" },
        "on-brand": { "$value": "{primitive.color.navy.900}" }
      },
      "icon": {
        "muted": { "$value": "{primitive.color.gray.500}" },
        "primary": { "$value": "{primitive.color.white}" },
        "brand": { "$value": "{primitive.color.green.500}" },
        "esg": { "$value": "{primitive.color.green.200}" },
        "danger": { "$value": "{primitive.color.red.400}" }
      },
      "border": {
        "default": { "$value": "{primitive.color.navy.700}", "$description": "Cartões e divisórias (decorativo)" },
        "control": { "$value": "{primitive.color.gray.500}", "$description": "Campos, caixas de seleção e interruptores: ≥ 3:1 (WCAG 1.4.11)" },
        "focus": { "$value": "{primitive.color.green.500}" },
        "brand": { "$value": "{primitive.color.green.500}" },
        "brand-subtle": { "$value": "#1DDB6A24", "$description": "Verde 14%" },
        "esg-subtle": { "$value": "#A8EFC433", "$description": "Verde ESG 20%" },
        "danger": { "$value": "{primitive.color.red.400}" },
        "danger-subtle": { "$value": "#FF5A5F59", "$description": "Alerta 35%" }
      }
    }
  },
  "component": {
    "button": {
      "height": { "$type": "dimension", "$value": "48px" },
      "height-small": { "$type": "dimension", "$value": "36px" },
      "radius": { "$type": "dimension", "$value": "{primitive.radius.md}" }
    },
    "control": {
      "height": { "$type": "dimension", "$value": "48px" },
      "touch-target": { "$type": "dimension", "$value": "44px", "$description": "Área mínima de toque (ADR-20)" }
    },
    "layout": {
      "content-max": { "$type": "dimension", "$value": "1440px", "$description": "Conteúdo limitado e centralizado acima disso (ADR-20)" },
      "sidebar": { "$type": "dimension", "$value": "256px" },
      "topbar": { "$type": "dimension", "$value": "64px" },
      "bottom-nav": { "$type": "dimension", "$value": "72px" }
    }
  },
  "contrast-pairs": {
    "$description": "Pares texto/fundo que o script de contraste aprova (ADR-19). min: 4.5 para texto, 3 para ícones e bordas de controles.",
    "pairs": {
      "$type": "other",
      "$value": [
        { "fg": "semantic.color.text.primary", "bg": "semantic.color.bg.app", "min": 4.5 },
        { "fg": "semantic.color.text.primary", "bg": "semantic.color.bg.surface", "min": 4.5 },
        { "fg": "semantic.color.text.muted", "bg": "semantic.color.bg.app", "min": 4.5 },
        { "fg": "semantic.color.text.muted", "bg": "semantic.color.bg.surface", "min": 4.5 },
        { "fg": "semantic.color.text.muted", "bg": "semantic.color.bg.field", "on": "semantic.color.bg.surface", "min": 4.5 },
        { "fg": "semantic.color.text.muted", "bg": "semantic.color.bg.brand-subtle", "on": "semantic.color.bg.app", "min": 4.5 },
        { "fg": "semantic.color.text.muted", "bg": "semantic.color.bg.field-disabled", "on": "semantic.color.bg.surface", "min": 4.5 },
        { "fg": "semantic.color.text.placeholder", "bg": "semantic.color.bg.field", "on": "semantic.color.bg.surface", "min": 4.5 },
        { "fg": "semantic.color.text.brand", "bg": "semantic.color.bg.app", "min": 4.5 },
        { "fg": "semantic.color.text.brand", "bg": "semantic.color.bg.surface", "min": 4.5 },
        { "fg": "semantic.color.text.brand", "bg": "semantic.color.bg.brand-soft", "on": "semantic.color.bg.surface", "min": 4.5 },
        { "fg": "semantic.color.text.esg", "bg": "semantic.color.bg.esg-soft", "on": "semantic.color.bg.app", "min": 4.5 },
        { "fg": "semantic.color.text.danger", "bg": "semantic.color.bg.app", "min": 4.5 },
        { "fg": "semantic.color.text.danger", "bg": "semantic.color.bg.surface", "min": 4.5 },
        { "fg": "semantic.color.text.on-brand", "bg": "semantic.color.bg.brand", "min": 4.5 },
        { "fg": "semantic.color.icon.muted", "bg": "semantic.color.bg.app", "min": 3 },
        { "fg": "semantic.color.icon.muted", "bg": "semantic.color.bg.surface", "min": 3 },
        { "fg": "semantic.color.border.control", "bg": "semantic.color.bg.app", "min": 3 },
        { "fg": "semantic.color.border.control", "bg": "semantic.color.bg.surface", "min": 3 },
        { "fg": "semantic.color.border.focus", "bg": "semantic.color.bg.app", "min": 3 },
        { "fg": "semantic.color.border.focus", "bg": "semantic.color.bg.surface", "min": 3 }
      ]
    }
  }
}
