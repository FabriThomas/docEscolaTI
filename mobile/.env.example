# Copie para .env. Valores de exemplo, nunca reais.
# Endereço da API do FastAPI (ADR-13). No emulador Android, 10.0.2.2 é o localhost do computador.
EXPO_PUBLIC_API_URL=http://10.0.2.2:8000/api/v1
# "sim" usa as respostas de exemplo do app enquanto as rotas do backend não existem. Qualquer outro valor chama a API de verdade.
EXPO_PUBLIC_USAR_MOCK=sim
